# Airflow
AIRFLOW_UID=50000
# dbt 연동 (common/dbt.py). Linux 서버는 docker.sock 그룹 GID 필수: stat -c %g /var/run/docker.sock
# DOCKER_GID=
# DBT_CONTAINER=dev-dbt
# dev | prd (선택) 실패 알림 메시지의 "환경" 표시용. 미설정 시 dev
AIRFLOW_ENV=dev
AIRFLOW_DOMAIN=airflow.local
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# SMTP (메일 발송 - plugins/common/mail.py: 업무 메일 + 실패 알림 메일)
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM_EMAIL=
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
