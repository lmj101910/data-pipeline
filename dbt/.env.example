# Airflow 에서 dbt 를 실행할 때는 이 파일이 필요 없습니다.
#   접속 정보는 Airflow Connection 에서 읽어 실행할 때만 넘깁니다 (airflow/plugins/common/dbt.py).
# 터미널에서 직접 `docker compose exec dbt dbt run` 할 때만 cp .env.example .env 후 값을 채우세요.
# 운영 서버에는 비밀번호를 이 파일에 두지 않는 것을 권장합니다.

# PostgreSQL (postgresql/docker-compose.yaml 참고)
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DBNAME=
PG_SCHEMA=public

# Yellowbrick (dbt-postgres 어댑터로 접속, 와이어 호환)
YB_HOST=
YB_PORT=5432
YB_USER=
YB_PASSWORD=
YB_DBNAME=
YB_SCHEMA=public

# MSSQL (mssql/docker-compose.yaml 참고)
MSSQL_HOST=host.docker.internal
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DATABASE=
MSSQL_SCHEMA=dbo
