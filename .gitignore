# =====================================================================
# 화이트리스트 방식: 기본은 전부 제외하고, 아래에 적은 파일만 올린다.
# 올릴 수 있는 것: Docker 관련 파일(docker-compose, Dockerfile, nginx 설정,
#                 이미지 빌드용 requirements.txt) + .env.example
# 절대 올리지 않는 것: .py 코드, .env(비밀키), DAG/플러그인, 업무 데이터, 압축 파일
# =====================================================================

# 1) 전부 제외 (하위 폴더 안 파일을 다시 허용하려면 폴더만 탐색 허용)
*
!*/

# 2) 허용 목록
!/.gitignore
!/.devcontainer/devcontainer.json

!/airflow/docker-compose.yaml
!/airflow/Dockerfile
!/airflow/requirements.txt
!/airflow/nginx/airflow.conf
!/airflow/.env.example
!/airflow/config/.gitkeep
!/airflow/dags/.gitkeep
!/airflow/plugins/.gitkeep

!/dbt/docker-compose.yaml
!/dbt/Dockerfile
!/dbt/requirements.txt
!/dbt/.env.example

!/gitlab/.env.example
!/runner/docker-compose.yaml
!/runner/.env.example
!/mssql/docker-compose.yaml
!/postgresql/docker-compose.yaml

# 3) 강제 제외 (위 허용 목록보다 우선)
**/.env
**/.env.*
!**/.env.example
**/*.py
**/*.zip
**/*.tar.gz
**/.DS_Store
# 내부에 별도 .git 이 있는 예전 코드 폴더 (통째로 제외)
/airflow/dags/old_py_files/
# 초기 root 비밀번호가 하드코딩되어 있음. 환경변수로 바꾸기 전까지 제외
/gitlab/docker-compose.yaml

# 4) 확인된 DAG (사용자가 직접 확인한 파일만 한 줄씩 추가)
#    예) !/airflow/dags/sample/sample_dag.py
